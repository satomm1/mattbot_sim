Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Value: true
    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Navigation map
      Topic: /navigation_map
      Value: true
    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Object belief map
      Topic: /object_belief_map
      Value: false
    - Alpha: 0.35
      Class: rviz/Map
      Color Scheme: raw
      Draw Behind: false
      Enabled: true
      Name: Observation viewsheds
      Topic: /observation/viewsheds
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /sim/objects
      Name: True objects (sim)
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /observation/stops
      Name: Observation stops
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /object_array
      Name: Mapper confirmed objects
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Name: Smoothed path
      Topic: /cmd_smoothed_path
      Value: true
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.15
      Name: True pose (sim)
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Shape: Arrow
      Topic: /sim/true_pose
      Value: true
    - Alpha: 1
      Class: rviz/LaserScan
      Color: 255; 0; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: Scan (sim, scan:=true)
      Size (m): 0.05
      Style: Points
      Topic: /scan
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 40
      Target Frame: base_footprint
      Value: TopDownOrtho (rviz)
Window Geometry:
  Height: 900
  Width: 1400
